          },
          "jobCode": {
            "type": "string"
          }
        },
        "required": ["executionMode", "jobCode"],
        "type": "object"
      },
      "OperationalRegisteredJobsResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OperationalRegisteredJobResponse"
            },
            "type": "array"
