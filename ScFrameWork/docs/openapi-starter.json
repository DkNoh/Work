            "format": "uuid",
            "type": "string"
          },
          "componentCode": {
            "enum": ["ROOT"],
            "type": "string"
          },
          "eventCode": {
            "enum": ["VUE_ERROR", "WINDOW_ERROR", "UNHANDLED_REJECTION", "UNKNOWN_RUNTIME"],
            "type": "string"
          },
          "routeCode": {
            "maxLength": 64,
            "type": "string"
          },
          "schemaVersion": {
            "enum": [1],
            "format": "int32",
            "maximum": 1,
            "minimum": 1,
            "type": "integer"
          },
          "source": {
            "enum": ["VUE", "WINDOW", "REJECTION"],
            "type": "string"
