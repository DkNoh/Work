      },
      "OperationalScheduleResponse": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "cron": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "jobCode": {
            "type": "string"
          },
          "misfirePolicy": {
            "enum": ["SKIP", "FIRE_ONCE"],
            "type": "string"
          },
          "nextFireAt": {
            "format": "date-time",
