          },
          "timeZone": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": ["cron", "enabled", "jobCode", "misfirePolicy", "timeZone"],
        "type": "object"
      },
      "OperationalSchedulePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OperationalScheduleResponse"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "maximum": 1000000,
            "minimum": 0,
