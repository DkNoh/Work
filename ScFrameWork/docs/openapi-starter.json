          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "jobCode": {
            "type": "string"
          },
          "reasonCode": {
            "type": ["string", "null"]
          },
          "runKey": {
            "format": "uuid",
            "type": "string"
          },
          "scheduleId": {
            "format": "int64",
            "type": "integer"
          },
          "scheduledAt": {
            "format": "date-time",
