        "required": [
          "attempt",
          "completedAt",
          "id",
          "jobCode",
          "reasonCode",
          "runKey",
          "scheduleId",
          "scheduledAt",
          "startedAt",
          "state"
        ],
        "type": "object"
      },
      "OperationalScheduleInput": {
        "properties": {
