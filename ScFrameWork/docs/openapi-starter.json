          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "lastSeenAt": {
            "format": "date-time",
            "type": "string"
          },
          "occurrenceCount": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          },
          "routeCode": {
            "type": "string"
          },
          "source": {
            "enum": ["VUE", "WINDOW", "REJECTION"],
            "type": "string"
          }
        },
        "required": [
          "appVersion",
          "componentCode",
          "eventCode",
          "fingerprint",
          "firstSeenAt",
          "id",
          "lastSeenAt",
          "occurrenceCount",
          "routeCode",
          "source"
