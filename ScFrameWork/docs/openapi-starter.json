          },
          "nextAttemptAt": {
            "format": "date-time",
            "type": "string"
          },
          "publishedAt": {
            "format": "date-time",
            "type": ["string", "null"]
          },
          "state": {
            "enum": ["PENDING", "CLAIMED", "PUBLISHED", "COMPLETED", "DEAD"],
            "type": "string"
          },
          "type": {
            "enum": ["SECURITY_AUDIT", "FILE_DELETE", "MESSAGE_DEMO"],
            "type": "string"
          }
        },
        "required": [
          "completedAt",
          "createdAt",
          "dispatchAttempts",
          "eventId",
          "lastFailureCode",
          "nextAttemptAt",
          "publishedAt",
          "state",
          "type"
        ],
        "type": "object"
      },
      "OperationMessagePage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OperationMessageItem"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "maximum": 1000000,
            "minimum": 0,
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "total": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": ["items", "page", "size", "total"],
        "type": "object"
      },
      "OperationalRegisteredJobResponse": {
        "properties": {
          "executionMode": {
            "enum": ["TRANSACTIONAL", "NON_TRANSACTIONAL"],
