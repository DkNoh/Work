      },
      "OperationalScheduleUpdateInput": {
        "properties": {
          "cron": {
            "maxLength": 120,
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "jobCode": {
            "maxLength": 64,
            "type": "string"
          },
          "misfirePolicy": {
