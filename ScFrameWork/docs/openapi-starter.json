        },
        "required": ["items"],
        "type": "object"
      },
      "OperationalRunPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OperationalRunResponse"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "maximum": 1000000,
            "minimum": 0,
