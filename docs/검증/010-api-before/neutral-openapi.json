{
  "openapi": "3.1.0",
  "info": {
    "title": "sc-reference-app",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "같은 출처의 실행 서버"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": ["session"],
        "summary": "폼 로그인",
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "description": "GET /api/auth/csrf가 발급한 token. Swagger interceptor가 갱신한다.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                },
                "required": ["password", "username"]
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "성공, 본문 없음"
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "CSRF 거부",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["session"],
        "summary": "세션 로그아웃",
        "parameters": [
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "description": "GET /api/auth/csrf가 발급한 token. Swagger interceptor가 갱신한다.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "성공, 본문 없음"
          },
          "401": {
            "description": "인증 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "CSRF 거부",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/examples/{id}": {
      "put": {
        "tags": ["example-controller"],
        "summary": "revision을 확인하여 예제 수정",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateExample"
              }
            }
          },
          "required": true
        },
        "responses": {
          "409": {
            "description": "낙관적 잠금 충돌",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/examples": {
      "get": {
        "tags": ["example-controller"],
        "summary": "중립 예제 목록: 단순 조회는 JPA",
        "operationId": "list",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ExamplePage"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["example-controller"],
        "summary": "예제 생성",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExample"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "입력 오류",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ExampleDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/integration/echo": {
      "get": {
        "tags": ["echo-controller"],
        "summary": "OpenFeign 외부 HTTP 연결 예제",
        "operationId": "echo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": ["common-endpoints"],
        "summary": "애플리케이션 기본 상태",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/examples/summary": {
      "get": {
        "tags": ["example-controller"],
        "summary": "MyBatis 읽기 연결 예제",
        "operationId": "summary",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ExampleSummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["common-endpoints"],
        "summary": "현재 로그인 사용자",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf": {
      "get": {
        "tags": ["common-endpoints"],
        "summary": "현재 세션의 CSRF 토큰 발급",
        "operationId": "csrf",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            }
          }
        }
      },
      "FieldViolation": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "UpdateExample": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "revision": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        },
        "required": ["revision", "title"]
      },
      "CreateExample": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": ["title"]
      },
      "ExampleDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": ["id", "revision", "title"]
      },
      "EchoResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": ["message"]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "application": {
            "type": "string"
          }
        },
        "required": ["application", "status"]
      },
      "ExamplePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExampleDto"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": ["items", "page", "size", "total"]
      },
      "ExampleSummary": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": ["total"]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["roles", "username"]
      },
      "CsrfResponse": {
        "type": "object",
        "properties": {
          "headerName": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": ["headerName", "token"]
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "description": "같은 브라우저의 로그인 세션. HttpOnly 쿠키를 Authorize 입력으로 설정하지 않는다.",
        "name": "JSESSIONID",
        "in": "cookie"
      }
    }
  }
}
