{
  "name": "@sc/ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": {
      "types": "./dist/types/styles.d.ts",
      "default": "./dist/sc-ui.css"
    },
    "./tokens": {
      "sass": "./dist/tokens.scss",
      "default": "./dist/tokens.scss"
    },
    "./table": {
      "types": "./dist/types/table/index.d.ts",
      "import": "./dist/table.js",
      "default": "./dist/table.js"
    },
    "./charts": {
      "types": "./dist/types/charts/index.d.ts",
      "import": "./dist/charts.js",
      "default": "./dist/charts.js"
    },
    "./editor": {
      "types": "./dist/types/editor/index.d.ts",
      "import": "./dist/editor.js",
      "default": "./dist/editor.js"
    },
    "./board": {
      "types": "./dist/types/board/index.d.ts",
      "import": "./dist/board.js",
      "default": "./dist/board.js"
    },
    "./image": {
      "types": "./dist/types/image/index.d.ts",
      "import": "./dist/image.js",
      "default": "./dist/image.js"
    }
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "npm run tokens:check && vue-tsc --noEmit -p tsconfig.json",
    "build": "node ../../../scripts/build-library.mjs .",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check"
  },
  "peerDependencies": {
    "vue": "3.5.43",
    "vuetify": "4.2.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vue-tsc": "3.3.12"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/vue": "0.5.0",
    "@floating-ui/dom": "1.7.6",
    "@tanstack/table-core": "9.2.6",
    "@tanstack/virtual-core": "3.17.11",
    "@tanstack/vue-table": "9.2.6",
    "@tanstack/vue-virtual": "3.13.39",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/vue-3": "3.31.4",
    "echarts": "6.1.0",
    "konva": "10.7.1",
    "vue-echarts": "8.3.1",
    "vue-konva": "4.0.1"
  },
  "license": "UNLICENSED",
  "files": [
    "dist",
    "README.md",
    "UNLICENSED",
    "THIRD_PARTY_NOTICES"
  ],
  "types": "./dist/types/index.d.ts",
  "style": "./dist/sc-ui.css",
  "sass": "./dist/tokens.scss"
}
