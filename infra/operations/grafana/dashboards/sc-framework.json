{
  "uid": "sc-framework-operations",
  "title": "ScFramework Operations",
  "description": "HTTP, JVM and registered operational events; sanitized logs and traces.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["sc-framework"],
  "panels": [
    {
      "id": 1,
      "title": "Requests / second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sc-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count[5m]))" }]
    },
    {
      "id": 2,
      "title": "HTTP 5xx / second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sc-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP p95 seconds",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sc-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le)(rate(http_server_requests_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "title": "JVM heap bytes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "sc-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})" }]
    },
    {
      "id": 5,
      "title": "Operational events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "sc-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind,outcome)(sc_operations_events_total)",
          "legendFormat": "{{kind}} {{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Sanitized operational logs",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "sc-loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"sc-reference-app|sc-starter-app\"}",
          "queryType": "range"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    }
  ]
}
