{
  "name": "__APP_NAME__",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11.13.0 <12"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit -p frontend/tsconfig.json",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts",
    "lint": "eslint frontend scripts --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "node scripts/openapi-types.mjs",
    "api:check": "node scripts/openapi-types.mjs --check",
    "verify": "npm run format:check && npm run lint && npm run api:check && npm run build",
    "build:jar": "bash scripts/build.sh"
  },
  "dependencies": {
    "@sc/ui": "file:vendor/npm/__UI_TARBALL__",
    "@sc/runtime": "file:vendor/npm/__RUNTIME_TARBALL__",
    "@sc/date": "file:vendor/npm/__DATE_TARBALL__",
    "@sc/excel": "file:vendor/npm/__EXCEL_TARBALL__",
    "@sc/i18n": "file:vendor/npm/__I18N_TARBALL__",
    "vue": "3.5.43",
    "vuetify": "4.2.4",
    "vue-router": "5.3.1",
    "pinia": "4.0.3",
    "@tanstack/vue-query": "5.104.1",
    "@mdi/js": "7.4.47",
    "vee-validate": "4.15.1",
    "zod": "4.6.5",
    "vue-i18n": "11.1.12",
    "@vueuse/core": "15.0.0"
  },
  "devDependencies": {
    "vite": "8.3.1",
    "@vitejs/plugin-vue": "6.0.9",
    "vite-plugin-vuetify": "2.1.3",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.12",
    "sass-embedded": "1.105.1",
    "@types/node": "24.19.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "typescript-eslint": "8.71.1",
    "vue-eslint-parser": "10.4.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "esbuild": "0.28.1"
  }
}
